{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm install --include=dev && npm --prefix backend install --include=dev && npm --prefix backend run prisma:generate",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/hospital-management/browser",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
