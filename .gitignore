# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/backend/dist
/tmp
/out-tsc
/bazel-out
# Angular application source is TypeScript-only. Keep accidental in-place compiler output out.
/src/**/*.js
/src/**/*.js.map

# Node
/node_modules
/backend/node_modules
npm-debug.log
yarn-error.log
*.log
*.log.*

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/backend/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
backend/uploads/

# Local secrets and credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
backend/secrets/

# System files
.DS_Store
Thumbs.db
